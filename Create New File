    "df['day']=df['datetime'].dt.day\n",
    "\n",
    "def weekday_or_weekend(year,month,day):\n",
    "    try:\n",
    "        d=datetime(year,month,day)\n",
    "        return 0 if d.weekday()>4 else 1\n",
    "    except ValueError:\n",
    "        return np.nan\n",
    "\n",
    "df['weekday']=df.apply(lambda x: weekday_or_weekend (x['year'],x['month'],x['day']),axis=1)\n",
    "df.head()"
